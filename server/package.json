{
  "name": "vit-cloud-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Private Cloud Storage System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx src/prisma/seed.ts",
    "test": "vitest run",
    "test:security": "vitest run tests/security.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "clamscan": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^19.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "uuid": "^11.1.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.2"
