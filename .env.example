# ==============================================================================
# Private Cloud Storage System - Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
# For local containerized Postgres: postgresql://postgres:postgres@localhost:5432/cloud_storage?schema=public
# Or provide your external PostgreSQL / Neon / Supabase connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_storage?schema=public"

# Cryptographic Master Key (Envelope Encryption)
# 256-bit AES master key in hex format (64 hex characters)
# Generate one using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
STORAGE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_and_long_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_and_long_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage Pool Limits (20 GB Laptop Pool & 200 MB Student Quota)
STORAGE_ROOT_DIR=./storage
STORAGE_VAULT_DIR=./storage/vault
STORAGE_QUARANTINE_DIR=./storage/quarantine
STORAGE_CHUNKS_DIR=./storage/chunks
DEFAULT_USER_QUOTA_BYTES=209715200       # 200 MB per student (200 * 1024 * 1024)
MAX_FILE_SIZE_BYTES=209715200            # Max individual upload size (200 MB)
DISK_GUARD_THRESHOLD_MB=1024             # Abort uploads if physical free disk < 1 GB (1024 MB)
STORAGE_POOL_MAX_BYTES=21474836480       # 20 GB laptop storage pool capacity

# Security & Upload Validation Rules
ALLOWED_EMAIL_DOMAIN=vit.edu
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
DEV_OTP_CONSOLE=true                     # When true, prints OTP directly to console stdout

# Archive Inspection Limits (Zip Bomb & Zip Slip Guardrails)
ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000 # 500 MB max uncompressed zip payload
ARCHIVE_MAX_RATIO=100                    # Maximum uncompressed:compressed ratio (100:1)
ARCHIVE_MAX_ENTRIES=1000                 # Maximum files allowed in archive
ARCHIVE_MAX_DEPTH=3                      # Maximum directory nesting depth inside archive

# ClamAV Antivirus Scanner
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000
USE_FALLBACK_SCANNER=true                # When true, uses embedded EICAR/signature scanner if ClamAV daemon is unreachable

# Email / SMTP Configuration (Optional in development if DEV_OTP_CONSOLE=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VIT Cloud Storage <no-reply@vit.edu>"
